rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/workspace/config {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['categories', 'nextMeetingId', 'nextCategoryId', 'version'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 100
        && request.resource.data.nextMeetingId is int
        && request.resource.data.nextMeetingId > 0
        && request.resource.data.nextCategoryId is int
        && request.resource.data.nextCategoryId > 0
        && request.resource.data.version is int;
    }
    match /users/{userId}/meetings/{meetingId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['id', 'category_id', 'title', 'starts_at', 'ends_at', 'attendees', 'discussion', 'actions', 'notes', 'created_at', 'updated_at', 'version'])
        && request.resource.data.id is int
        && meetingId == string(request.resource.data.id)
        && request.resource.data.category_id is int
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.starts_at is string
        && request.resource.data.starts_at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && request.resource.data.ends_at is string
        && (request.resource.data.ends_at == '' || request.resource.data.ends_at >= request.resource.data.starts_at)
        && request.resource.data.attendees is string
        && request.resource.data.attendees.size() <= 5000
        && request.resource.data.discussion is string
        && request.resource.data.discussion.size() <= 100000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 50000
        && request.resource.data.actions is list
        && request.resource.data.actions.size() <= 200
        && request.resource.data.created_at is string
        && request.resource.data.updated_at is string
        && request.resource.data.version is int
        && request.resource.data.version > 0;
    }
  }
}
